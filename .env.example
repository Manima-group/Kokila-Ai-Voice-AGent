# ---- Copy to .env and fill in. NEVER commit .env ----
ENVIRONMENT=development            # development | staging | production
PUBLIC_BASE_URL=http://localhost:8000   # public HTTPS URL of the API (used for provider webhooks/tools)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false                # true in production (HTTPS)

POSTGRES_USER=kokila
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=kokila

# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Voice: mock (local, no real calls) | retell
VOICE_PROVIDER=mock
RETELL_API_KEY=
MOCK_WEBHOOK_SECRET=change-me-mock-secret

# Business Assistant LLM — explicit provider AND model are required (no silent default).
LLM_PROVIDER=none                  # none | openai | anthropic
LLM_MODEL=                         # e.g. the exact model id from your provider's console
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=                     # optional web research (Personal mode)

# Razorpay (test keys first). Webhook URL: {PUBLIC_BASE_URL}/api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GST_RATE_PERCENT=18

# Google Calendar OAuth (redirect: {PUBLIC_BASE_URL}/api/v1/integrations/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

RATE_LIMIT_AUTH_PER_MINUTE=10
RAW_EVENT_RETENTION_DAYS=30
