# Copy to .env and fill in. Never commit real values.
KOKILA_ENV=development
POSTGRES_PASSWORD=change-me-owner
KOKILA_APP_DB_PASSWORD=change-me-app
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
KOKILA_JWT_SECRET=
# base64url 32 bytes, e.g. `python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`
KOKILA_DATA_ENCRYPTION_KEY=

# Reasoning: openai | anthropic | none | dev_mock (dev_mock only allowed in development/test; replies are labelled)
KOKILA_REASONING_PROVIDER=none
KOKILA_REASONING_FALLBACK_PROVIDER=none
KOKILA_OPENAI_API_KEY=
KOKILA_OPENAI_MODEL=
KOKILA_OPENAI_REALTIME_MODEL=
KOKILA_ANTHROPIC_API_KEY=
KOKILA_ANTHROPIC_MODEL=

# Realtime media (optional; browser speech is used when absent)
KOKILA_LIVEKIT_URL=
KOKILA_LIVEKIT_API_KEY=
KOKILA_LIVEKIT_API_SECRET=
